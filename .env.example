# Travelpayouts credentials (для link_converter и collection_link_converter)
# Скопируйте этот файл в .env и заполните реальными данными.
# НИКОГДА не коммитьте .env в git!

TRAVELPAYOUTS_EMAIL=your@email.com
TRAVELPAYOUTS_PASSWORD=your-secure-password
TRAVELPAYOUTS_HUMAN_INPUT=false   # true — если нужен ручной вход (капча и т.п.)

# Можно также задать DEBUG_MODE через окружение, но лучше в коде
# DEBUG_MODE=false
